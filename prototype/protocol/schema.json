{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://freetrain-online.invalid/contracts-v3.schema.json",
  "title": "GameDocument",
  "oneOf": [
    {
      "$ref": "#/$defs/WireMessage"
    },
    {
      "$ref": "#/$defs/SpatialQuery"
    },
    {
      "$ref": "#/$defs/SpatialPreview"
    }
  ],
  "$defs": {
    "Counter": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "format": "uint63"
    },
    "Money": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$",
      "format": "int64"
    },
    "Position": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "y": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "z": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ]
    },
    "Map": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "levels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "coordinateSystem": {
          "enum": [
            "hv",
            "prototypeXY"
          ]
        }
      },
      "required": [
        "width",
        "height",
        "levels",
        "coordinateSystem"
      ]
    },
    "Train": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "$ref": "#/$defs/Counter"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "position": {
          "$ref": "#/$defs/Position"
        },
        "cars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "controller": {
          "enum": [
            "automatic",
            "manual"
          ]
        },
        "carPositions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Position"
          }
        },
        "state": {
          "enum": [
            "moving",
            "station",
            "buffer",
            "blocked"
          ]
        },
        "controlLease": {
          "anyOf": [
            {
              "$ref": "#/$defs/ControlLease"
            },
            {
              "type": "null"
            }
          ]
        },
        "heading": {
          "$ref": "#/$defs/Heading"
        },
        "carHeadings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Heading"
          }
        }
      },
      "required": [
        "id",
        "revision",
        "name",
        "position",
        "cars",
        "controller",
        "carPositions",
        "state",
        "controlLease",
        "heading",
        "carHeadings"
      ]
    },
    "Station": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "$ref": "#/$defs/Counter"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "position": {
          "$ref": "#/$defs/Position"
        }
      },
      "required": [
        "id",
        "revision",
        "name",
        "position"
      ]
    },
    "Building": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "definitionId": {
          "type": "string",
          "minLength": 1
        },
        "position": {
          "$ref": "#/$defs/Position"
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      },
      "required": [
        "id",
        "definitionId",
        "position",
        "height"
      ]
    },
    "Removed": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trainIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "stationIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "buildingIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "trackPositions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Position"
          }
        }
      },
      "required": [
        "trainIds",
        "stationIds",
        "buildingIds",
        "trackPositions"
      ]
    },
    "Snapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "snapshot"
        },
        "worldEpoch": {
          "$ref": "#/$defs/Counter"
        },
        "revision": {
          "$ref": "#/$defs/Counter"
        },
        "tick": {
          "$ref": "#/$defs/Counter"
        },
        "paused": {
          "type": "boolean"
        },
        "cash": {
          "$ref": "#/$defs/Money"
        },
        "map": {
          "$ref": "#/$defs/Map"
        },
        "trains": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Train"
          }
        },
        "stations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Station"
          }
        },
        "buildings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Building"
          }
        },
        "tracks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Track"
          }
        },
        "ruleset": {
          "type": "string",
          "minLength": 1
        },
        "contentVersion": {
          "type": "string",
          "minLength": 1
        },
        "requiredPacks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RequiredPack"
          },
          "maxItems": 32
        }
      },
      "required": [
        "type",
        "worldEpoch",
        "revision",
        "tick",
        "paused",
        "cash",
        "map",
        "trains",
        "stations",
        "buildings",
        "tracks",
        "ruleset",
        "contentVersion",
        "requiredPacks"
      ]
    },
    "Delta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "delta"
        },
        "worldEpoch": {
          "$ref": "#/$defs/Counter"
        },
        "baseRevision": {
          "$ref": "#/$defs/Counter"
        },
        "revision": {
          "$ref": "#/$defs/Counter"
        },
        "tick": {
          "$ref": "#/$defs/Counter"
        },
        "trains": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Train"
          }
        },
        "stations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Station"
          }
        },
        "buildings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Building"
          }
        },
        "removed": {
          "$ref": "#/$defs/Removed"
        },
        "paused": {
          "type": "boolean"
        },
        "cash": {
          "$ref": "#/$defs/Money"
        },
        "tracks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Track"
          }
        },
        "ruleset": {
          "type": "string",
          "minLength": 1
        },
        "contentVersion": {
          "type": "string",
          "minLength": 1
        },
        "requiredPacks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RequiredPack"
          },
          "maxItems": 32
        }
      },
      "required": [
        "type",
        "worldEpoch",
        "baseRevision",
        "revision",
        "tick",
        "trains",
        "stations",
        "buildings",
        "removed",
        "paused",
        "cash",
        "tracks",
        "ruleset",
        "contentVersion",
        "requiredPacks"
      ]
    },
    "CommandPayload": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "run"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "pause"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "step"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "renameStation"
            },
            "stationId": {
              "type": "string",
              "minLength": 1
            },
            "expectedRevision": {
              "$ref": "#/$defs/Counter"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "required": [
            "kind",
            "stationId",
            "expectedRevision",
            "name"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "buildTrack"
            },
            "position": {
              "$ref": "#/$defs/Position"
            },
            "shape": {
              "enum": [
                "eastWest",
                "northSouth",
                "curveSE",
                "curveSW",
                "curveNE",
                "curveNW",
                "junctionE",
                "buffer"
              ]
            }
          },
          "required": [
            "kind",
            "position",
            "shape"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "removeTrack"
            },
            "position": {
              "$ref": "#/$defs/Position"
            },
            "expectedRevision": {
              "$ref": "#/$defs/Counter"
            }
          },
          "required": [
            "kind",
            "position",
            "expectedRevision"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "setController"
            },
            "trainId": {
              "type": "string",
              "minLength": 1
            },
            "expectedRevision": {
              "$ref": "#/$defs/Counter"
            },
            "controller": {
              "enum": [
                "automatic",
                "manual"
              ]
            },
            "leaseId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "trainId",
            "expectedRevision",
            "controller",
            "leaseId"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "controllerInput"
            },
            "trainId": {
              "type": "string",
              "minLength": 1
            },
            "inputSequence": {
              "$ref": "#/$defs/Counter"
            },
            "pass": {
              "type": "boolean"
            },
            "depart": {
              "type": "boolean"
            },
            "reverse": {
              "type": "boolean"
            },
            "left": {
              "type": "boolean"
            },
            "right": {
              "type": "boolean"
            },
            "reset": {
              "type": "boolean"
            },
            "leaseId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "trainId",
            "inputSequence",
            "pass",
            "depart",
            "reverse",
            "left",
            "right",
            "reset",
            "leaseId"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "acquireControl"
            },
            "trainId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "trainId"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "releaseControl"
            },
            "trainId": {
              "type": "string",
              "minLength": 1
            },
            "leaseId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "trainId",
            "leaseId"
          ]
        }
      ]
    },
    "Command": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "command"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "expectedWorldEpoch": {
          "$ref": "#/$defs/Counter"
        },
        "payload": {
          "$ref": "#/$defs/CommandPayload"
        }
      },
      "required": [
        "type",
        "requestId",
        "expectedWorldEpoch",
        "payload"
      ]
    },
    "Accepted": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "accepted"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "worldEpoch": {
          "$ref": "#/$defs/Counter"
        },
        "sequence": {
          "$ref": "#/$defs/Counter"
        },
        "tick": {
          "$ref": "#/$defs/Counter"
        },
        "revision": {
          "$ref": "#/$defs/Counter"
        }
      },
      "required": [
        "type",
        "requestId",
        "worldEpoch",
        "sequence",
        "tick",
        "revision"
      ]
    },
    "Rejected": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "rejected"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "enum": [
            "invalidPlacement",
            "staleEpoch",
            "staleRevision",
            "insufficientFunds",
            "notAuthorized",
            "queueFull",
            "invalidInput",
            "requestConflict",
            "retryWindowFull",
            "leaseRequired",
            "controlBusy"
          ]
        },
        "arguments": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "requestId",
        "code",
        "arguments"
      ]
    },
    "Join": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "join"
        },
        "protocolVersion": {
          "const": 3
        },
        "contentVersion": {
          "type": "string",
          "minLength": 1
        },
        "serverIncarnation": {
          "type": "string",
          "minLength": 1
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "participantId": {
          "type": "string",
          "minLength": 1
        },
        "worldEpoch": {
          "$ref": "#/$defs/Counter"
        },
        "snapshot": {
          "$ref": "#/$defs/Snapshot"
        },
        "role": {
          "enum": [
            "owner",
            "operator",
            "observer"
          ]
        },
        "ruleset": {
          "type": "string",
          "minLength": 1
        },
        "requiredPacks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RequiredPack"
          },
          "maxItems": 32
        }
      },
      "required": [
        "type",
        "protocolVersion",
        "contentVersion",
        "serverIncarnation",
        "sessionId",
        "participantId",
        "worldEpoch",
        "snapshot",
        "role",
        "ruleset",
        "requiredPacks"
      ]
    },
    "WireMessage": {
      "oneOf": [
        {
          "$ref": "#/$defs/Join"
        },
        {
          "$ref": "#/$defs/Command"
        },
        {
          "$ref": "#/$defs/Accepted"
        },
        {
          "$ref": "#/$defs/Rejected"
        },
        {
          "$ref": "#/$defs/Snapshot"
        },
        {
          "$ref": "#/$defs/Delta"
        },
        {
          "$ref": "#/$defs/Resync"
        },
        {
          "$ref": "#/$defs/Heartbeat"
        },
        {
          "$ref": "#/$defs/InputReset"
        },
        {
          "$ref": "#/$defs/SoundEvent"
        }
      ]
    },
    "Track": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "position": {
          "$ref": "#/$defs/Position"
        },
        "shape": {
          "enum": [
            "eastWest",
            "northSouth",
            "curveSE",
            "curveSW",
            "curveNE",
            "curveNW",
            "junctionE",
            "buffer"
          ]
        },
        "revision": {
          "$ref": "#/$defs/Counter"
        }
      },
      "required": [
        "position",
        "shape",
        "revision"
      ]
    },
    "Resync": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "resync"
        }
      },
      "required": [
        "type"
      ]
    },
    "Heartbeat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "heartbeat"
        }
      },
      "required": [
        "type"
      ]
    },
    "InputReset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "inputReset"
        }
      },
      "required": [
        "type"
      ]
    },
    "SoundEvent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "soundEvent"
        },
        "eventId": {
          "type": "string",
          "minLength": 1
        },
        "worldEpoch": {
          "$ref": "#/$defs/Counter"
        },
        "kind": {
          "const": "stationArrived"
        }
      },
      "required": [
        "type",
        "eventId",
        "worldEpoch",
        "kind"
      ]
    },
    "ControlLease": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "participantId": {
          "type": "string",
          "minLength": 1
        },
        "leaseId": {
          "type": "string",
          "minLength": 1
        },
        "expiresAt": {
          "$ref": "#/$defs/Counter"
        }
      },
      "required": [
        "participantId",
        "leaseId",
        "expiresAt"
      ]
    },
    "Heading": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "RequiredPack": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "catalogHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "catalogHash"
      ]
    },
    "SpatialQuery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expectedWorldEpoch": {
          "$ref": "#/$defs/Counter"
        },
        "position": {
          "$ref": "#/$defs/Position"
        },
        "anchor": {
          "anyOf": [
            {
              "$ref": "#/$defs/Position"
            },
            {
              "type": "null"
            }
          ]
        },
        "snap": {
          "enum": [
            0,
            4,
            8
          ]
        }
      },
      "required": [
        "expectedWorldEpoch",
        "position",
        "anchor",
        "snap"
      ]
    },
    "ProjectedPoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "a": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "b": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        }
      },
      "required": [
        "a",
        "b"
      ]
    },
    "StoragePosition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "h": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "v": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "z": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        }
      },
      "required": [
        "h",
        "v",
        "z"
      ]
    },
    "SpatialPreview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "worldEpoch": {
          "$ref": "#/$defs/Counter"
        },
        "revision": {
          "$ref": "#/$defs/Counter"
        },
        "ruleset": {
          "type": "string",
          "minLength": 1
        },
        "contentVersion": {
          "type": "string",
          "minLength": 1
        },
        "requiredPacks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RequiredPack"
          },
          "maxItems": 32
        },
        "position": {
          "$ref": "#/$defs/Position"
        },
        "inside": {
          "type": "boolean"
        },
        "projected": {
          "$ref": "#/$defs/ProjectedPoint"
        },
        "storage": {
          "anyOf": [
            {
              "$ref": "#/$defs/StoragePosition"
            },
            {
              "type": "null"
            }
          ]
        },
        "heading": {
          "anyOf": [
            {
              "$ref": "#/$defs/Heading"
            },
            {
              "type": "null"
            }
          ]
        },
        "distance": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
