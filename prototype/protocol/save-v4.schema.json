{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Canonical spatial, clock and random Save 4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "saveVersion",
    "ruleset",
    "contentVersion",
    "requiredPacks",
    "map",
    "rails",
    "clock",
    "paused",
    "random"
  ],
  "properties": {
    "saveVersion": {
      "const": 4
    },
    "ruleset": {
      "const": "reference-spatial-3"
    },
    "contentVersion": {
      "const": "reference-spatial-content-1"
    },
    "requiredPacks": {
      "const": [
        {
          "id": "reference-spatial",
          "version": "1",
          "catalogHash": "b40daa7c21d5cac12800a13e04a947df4ff1ba52833d6bd471cefbfbae38ee0c"
        }
      ]
    },
    "map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "levels",
        "coordinateSystem"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "levels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "coordinateSystem": {
          "const": "hv"
        }
      }
    },
    "rails": {
      "type": "array",
      "minItems": 8,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "x",
          "y",
          "z",
          "pattern"
        ],
        "properties": {
          "x": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "y": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "z": {
            "const": 0
          },
          "pattern": {
            "type": "integer",
            "minimum": 0,
            "maximum": 11
          }
        }
      }
    },
    "paused": {
      "type": "boolean"
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "absoluteMinute",
        "nextOrder",
        "pending"
      ],
      "properties": {
        "absoluteMinute": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "description": "Source minutes, 0 through 1128717404863199; checked by the codec."
        },
        "nextOrder": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "pending": {
          "type": "array",
          "maxItems": 0,
          "description": "Reference world has no gameplay action bindings yet; unbound actions are rejected."
        }
      }
    },
    "random": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "algorithm",
        "seed",
        "streams"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "algorithm": {
          "const": "subtractive-55-v1"
        },
        "seed": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "streams": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "state"
            ],
            "properties": {
              "id": {
                "enum": [
                  "construction",
                  "development",
                  "forest",
                  "land-selection",
                  "stadium",
                  "stock-economy",
                  "stock-effects",
                  "stock-tables",
                  "subsidiaries",
                  "time-length"
                ]
              },
              "state": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "index",
                  "values"
                ],
                "properties": {
                  "index": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 54
                  },
                  "values": {
                    "type": "array",
                    "minItems": 55,
                    "maxItems": 55,
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 2147483646
                    },
                    "contains": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              }
            }
          },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "const": "construction"
                  }
                }
              }
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "const": "development"
                  }
                }
              }
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "const": "forest"
                  }
                }
              }
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "const": "land-selection"
                  }
                }
              }
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "const": "stadium"
                  }
                }
              }
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "const": "stock-economy"
                  }
                }
              }
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "const": "stock-effects"
                  }
                }
              }
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "const": "stock-tables"
                  }
                }
              }
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "const": "subsidiaries"
                  }
                }
              }
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "const": "time-length"
                  }
                }
              }
            }
          ]
        }
      }
    }
  },
  "description": "Structural contract; codec also checks source clock range and canonical rail graph. Only Save 4 is supported; earlier save formats are rejected without conversion."
}
