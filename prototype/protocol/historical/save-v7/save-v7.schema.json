{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Canonical reference and packed terrain Save 7",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "saveVersion",
    "ruleset",
    "contentVersion",
    "requiredPacks",
    "map",
    "rails",
    "clock",
    "paused",
    "random",
    "spatial",
    "revision"
  ],
  "properties": {
    "saveVersion": {
      "const": 7
    },
    "ruleset": {
      "enum": [
        "reference-spatial-4",
        "terrain-state-1"
      ]
    },
    "contentVersion": {
      "type": "string",
      "minLength": 1
    },
    "requiredPacks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RequiredPack"
      },
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true
    },
    "map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "levels",
        "coordinateSystem"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        },
        "levels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "coordinateSystem": {
          "const": "hv"
        }
      }
    },
    "rails": {
      "type": "array",
      "minItems": 0,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "x",
          "y",
          "z",
          "pattern",
          "entityId"
        ],
        "properties": {
          "x": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "y": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "z": {
            "const": 0
          },
          "pattern": {
            "type": "integer",
            "minimum": 0,
            "maximum": 11
          },
          "entityId": {
            "$ref": "#/$defs/EntityId"
          }
        }
      }
    },
    "paused": {
      "type": "boolean"
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "absoluteMinute",
        "nextOrder",
        "pending"
      ],
      "properties": {
        "absoluteMinute": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "description": "Source minutes, 0 through 1128717404863199; checked by the codec."
        },
        "nextOrder": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "pending": {
          "type": "array",
          "maxItems": 0,
          "description": "Reference world has no gameplay action bindings yet; unbound actions are rejected."
        }
      }
    },
    "random": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "algorithm",
        "seed",
        "streams"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "algorithm": {
          "const": "subtractive-55-v1"
        },
        "seed": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "streams": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "state"
            ],
            "properties": {
              "id": {
                "enum": [
                  "construction",
                  "development",
                  "forest",
                  "land-selection",
                  "stadium",
                  "stock-economy",
                  "stock-effects",
                  "stock-tables",
                  "subsidiaries",
                  "time-length"
                ]
              },
              "state": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "index",
                  "values"
                ],
                "properties": {
                  "index": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 54
                  },
                  "values": {
                    "type": "array",
                    "minItems": 55,
                    "maxItems": 55,
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 2147483646
                    },
                    "contains": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              }
            }
          },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "const": "construction"
                  }
                }
              }
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "const": "development"
                  }
                }
              }
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "const": "forest"
                  }
                }
              }
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "const": "land-selection"
                  }
                }
              }
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "const": "stadium"
                  }
                }
              }
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "const": "stock-economy"
                  }
                }
              }
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "const": "stock-effects"
                  }
                }
              }
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "const": "stock-tables"
                  }
                }
              }
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "const": "subsidiaries"
                  }
                }
              }
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "const": "time-length"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "spatial": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nextEntityId": {
          "$ref": "#/$defs/EntityId"
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SpatialEntity"
          },
          "minItems": 0,
          "maxItems": 3400000
        }
      },
      "required": [
        "nextEntityId",
        "entities"
      ]
    },
    "revision": {
      "$ref": "#/$defs/Counter"
    },
    "packedTerrain": {
      "$ref": "#/$defs/PackedTerrain"
    }
  },
  "description": "Save 7 only. Actual packed terrain, exact installed profile, complete graph, allocator, provenance, clock and random bank are validated by the codec. No conversion or regeneration.",
  "$id": "https://freetrain-online.invalid/save-v7.schema.json",
  "$defs": {
    "EntityId": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "Counter": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "Money": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$"
    },
    "Position": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "y": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "z": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ]
    },
    "Definition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "packId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "contributionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "recipeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        }
      },
      "required": [
        "packId",
        "contributionId",
        "recipeId"
      ]
    },
    "VoxelMember": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "offset": {
          "$ref": "#/$defs/Position"
        },
        "transparent": {
          "type": "boolean"
        }
      },
      "required": [
        "offset",
        "transparent"
      ]
    },
    "SpatialEntity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/EntityId"
        },
        "revision": {
          "$ref": "#/$defs/Counter"
        },
        "definition": {
          "$ref": "#/$defs/Definition"
        },
        "anchor": {
          "$ref": "#/$defs/Position"
        },
        "footprint": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VoxelMember"
          },
          "minItems": 1,
          "maxItems": 65536
        },
        "owned": {
          "type": "boolean"
        },
        "silentlyReclaimable": {
          "type": "boolean"
        },
        "value": {
          "$ref": "#/$defs/Money"
        }
      },
      "required": [
        "id",
        "revision",
        "definition",
        "anchor",
        "footprint",
        "owned",
        "silentlyReclaimable",
        "value"
      ]
    },
    "RequiredPack": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "catalogHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "catalogHash"
      ]
    },
    "TerrainCell": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ground": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "surface": {
          "enum": [
            "natural",
            "cut",
            "terrace"
          ]
        }
      },
      "required": [
        "ground",
        "surface"
      ]
    },
    "TerrainTree": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "sprite": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1023
        }
      },
      "required": [
        "x",
        "y",
        "sprite"
      ]
    },
    "Forest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "definition": {
          "$ref": "#/$defs/Definition"
        },
        "trees": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TerrainTree"
          },
          "maxItems": 6
        }
      },
      "required": [
        "definition",
        "trees"
      ]
    },
    "TerrainOccupant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entityId": {
          "$ref": "#/$defs/EntityId"
        },
        "kind": {
          "enum": [
            "mountain",
            "terrace",
            "creek"
          ]
        },
        "ne": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "se": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "sw": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "nw": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "forest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Forest"
            },
            {
              "type": "null"
            }
          ]
        },
        "creekConnections": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        }
      },
      "required": [
        "entityId",
        "kind",
        "ne",
        "se",
        "sw",
        "nw",
        "forest",
        "creekConnections"
      ]
    },
    "TerrainProvenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {
          "const": "terrain-generation-1"
        },
        "source": {
          "enum": [
            "empty",
            "heightmap",
            "generated"
          ]
        },
        "requestHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "requestJson": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        }
      },
      "required": [
        "profile",
        "source",
        "requestHash",
        "requestJson"
      ]
    },
    "Terrain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 128
        },
        "waterLevel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "constructionMode": {
          "type": "boolean"
        },
        "geometryRevision": {
          "$ref": "#/$defs/Counter"
        },
        "nextEntityId": {
          "$ref": "#/$defs/EntityId"
        },
        "provenance": {
          "$ref": "#/$defs/TerrainProvenance"
        },
        "cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TerrainCell"
          },
          "maxItems": 1700000
        },
        "occupants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TerrainOccupant"
          },
          "maxItems": 3400000
        }
      },
      "required": [
        "name",
        "waterLevel",
        "constructionMode",
        "geometryRevision",
        "nextEntityId",
        "provenance",
        "cells",
        "occupants"
      ]
    },
    "PackedTerrain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 128
        },
        "waterLevel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "constructionMode": {
          "type": "boolean"
        },
        "geometryRevision": {
          "$ref": "#/$defs/Counter"
        },
        "nextEntityId": {
          "$ref": "#/$defs/EntityId"
        },
        "provenance": {
          "$ref": "#/$defs/TerrainProvenance"
        },
        "encoding": {
          "const": "terrain-packed-1"
        },
        "definitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Definition"
          },
          "maxItems": 64,
          "uniqueItems": true
        },
        "cells": {
          "type": "string",
          "maxLength": 357913944,
          "pattern": "^[A-Za-z0-9+/]*={0,2}$"
        },
        "occupantCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3400000
        },
        "occupants": {
          "type": "string",
          "maxLength": 357913944,
          "pattern": "^[A-Za-z0-9+/]*={0,2}$"
        }
      },
      "required": [
        "name",
        "waterLevel",
        "constructionMode",
        "geometryRevision",
        "nextEntityId",
        "provenance",
        "encoding",
        "definitions",
        "cells",
        "occupantCount",
        "occupants"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ruleset": {
            "const": "terrain-state-1"
          }
        },
        "required": [
          "ruleset"
        ]
      },
      "then": {
        "required": [
          "packedTerrain"
        ],
        "properties": {
          "rails": {
            "maxItems": 0,
            "type": "array"
          },
          "contentVersion": {
            "const": "terrain-content-1"
          },
          "packedTerrain": {
            "$ref": "#/$defs/PackedTerrain"
          },
          "spatial": {
            "type": "object",
            "properties": {
              "entities": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "rails": {
            "minItems": 8,
            "type": "array"
          },
          "revision": {
            "const": "0"
          },
          "contentVersion": {
            "const": "reference-spatial-content-2"
          },
          "spatial": {
            "type": "object",
            "properties": {
              "entities": {
                "type": "array",
                "minItems": 8
              }
            }
          },
          "packedTerrain": false
        }
      }
    }
  ]
}
