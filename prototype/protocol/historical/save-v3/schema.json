{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Canonical spatial and clock Save 3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "saveVersion",
    "ruleset",
    "contentVersion",
    "requiredPacks",
    "map",
    "rails",
    "clock",
    "paused"
  ],
  "properties": {
    "saveVersion": {
      "const": 3
    },
    "ruleset": {
      "const": "reference-spatial-2"
    },
    "contentVersion": {
      "const": "reference-spatial-content-1"
    },
    "requiredPacks": {
      "const": [
        {
          "id": "reference-spatial",
          "version": "1",
          "catalogHash": "b40daa7c21d5cac12800a13e04a947df4ff1ba52833d6bd471cefbfbae38ee0c"
        }
      ]
    },
    "map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "levels",
        "coordinateSystem"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "levels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "coordinateSystem": {
          "const": "hv"
        }
      }
    },
    "rails": {
      "type": "array",
      "minItems": 8,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "x",
          "y",
          "z",
          "pattern"
        ],
        "properties": {
          "x": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "y": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "z": {
            "const": 0
          },
          "pattern": {
            "type": "integer",
            "minimum": 0,
            "maximum": 11
          }
        }
      }
    },
    "paused": {
      "type": "boolean"
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "absoluteMinute",
        "nextOrder",
        "pending"
      ],
      "properties": {
        "absoluteMinute": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "description": "Source minutes, 0 through 1128717404863199; checked by the codec."
        },
        "nextOrder": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "pending": {
          "type": "array",
          "maxItems": 0,
          "description": "Reference world has no gameplay action bindings yet; unbound actions are rejected."
        }
      }
    }
  },
  "description": "Structural contract; codec also checks clock range, queue state and canonical rail graph. Save 2 upgrades at source start time, paused. Save 1 is unsupported."
}
