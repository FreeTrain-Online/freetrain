    {"id":"GEO-003","finding":"SingleRailRoad.build(equal endpoints) proceeds to invalid Direction; UI excludes it. Route preview returns empty while remove quote returns zero.","phase":"P4"},
    {"id":"GEO-004","finding":"Bridge support teardown ignores its owner argument; slope entity removal excludes BridgePierVoxel and leaves elected piers.","phase":"P3/P4"},
