# Copy to deploy/.env; use a long randomly generated value. Never commit .env.
FREETRAIN_ONLINE_OPERATOR_SECRET=replace-with-a-random-operator-key
FREETRAIN_ONLINE_IMAGE=freetrain-online:prototype
FREETRAIN_ONLINE_SITE=localhost
FREETRAIN_ONLINE_TLS=internal
FREETRAIN_ONLINE_BIND=127.0.0.1
FREETRAIN_ONLINE_HTTP_PORT=8080
FREETRAIN_ONLINE_HTTPS_PORT=8443
FREETRAIN_ONLINE_CHECKPOINT_INTERVAL=00:00:30
# For a public host: SITE=game.example.org, TLS=operator@example.org,
# BIND=0.0.0.0, HTTP_PORT=80, HTTPS_PORT=443; see doc/web-deployment.md.

# Optional plugin sets are never embedded in this image. Mount prepared sets
# read-only, or mount source sets plus a separate writable preparation cache.
# FreeTrainOnline__PluginDirectories__0=/plugins/additional-v2
# FreeTrainOnline__PluginDirectories__1=/plugins/another-set
# FreeTrainOnline__PluginCacheDirectory=/data/plugin-cache
