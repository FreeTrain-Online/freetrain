{$FREETRAIN_ONLINE_SITE:localhost} {
    tls {$FREETRAIN_ONLINE_TLS:internal}
    encode zstd gzip
    header X-Content-Type-Options nosniff
    reverse_proxy game:8080
}

http://{$FREETRAIN_ONLINE_SITE:localhost} {
    redir https://{$FREETRAIN_ONLINE_SITE:localhost}:{$FREETRAIN_ONLINE_HTTPS_PORT:8443}{uri} 308
}
